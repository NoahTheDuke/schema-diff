{:paths ["src" "resources"]
 :deps {babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        fipp/fipp {:mvn/version "0.6.29"}
        org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.namespace {:mvn/version "1.5.1"}
        prismatic/schema {:mvn/version "1.4.2"}}
 :aliases
 {:dev {:extra-paths ["dev" "corpus"]}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                 slipset/deps-deploy {:mvn/version "0.2.5"}}
          :ns-default build}}}
